# Provedor de IA ativo: openai, gemini ou groq
IA_PROVIDER=groq

# Groq (usada quando IA_PROVIDER=groq) - gratuito, sem cartão
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b

# OpenAI (usada quando IA_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (usada quando IA_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_FALLBACK=gemini-flash-lite-latest

# Servidor
PORT=3000
NODE_ENV=development

# Origem do frontend autorizada (CORS)
CORS_ORIGIN=http://localhost:5500

# Supabase - reservadas para uso futuro (não usadas nesta entrega)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
